# QuickR Environment Variables Configuration Example
PORT=53211
MONGODB_URI=mongodb://localhost:27017/quickr
JWT_SECRET=quickr_super_secret_jwt_key_987654321_production_grade_security
FRONTEND_URL=http://localhost:5173

# Optional: Public Registration Switch (default: false)
ALLOW_PUBLIC_REGISTRATION=false

# Optional: Local Ollama AI Engine Configuration
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b

# WhatsApp Business Cloud API Configuration (Leave blank for Development/Mock mode)
WHATSAPP_API_VERSION=v19.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
